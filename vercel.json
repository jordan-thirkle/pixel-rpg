{
  "cleanUrls": true,
  "headers": [
    {"source":"/game/:path*","headers":[{"key":"Cache-Control","value":"public, max-age=31536000, immutable"}]},
    {"source":"/play/:path*","headers":[{"key":"Cache-Control","value":"public, max-age=3600"}]},
    {"source":"/assets/:path*","headers":[{"key":"Cache-Control","value":"public, max-age=31536000, immutable"}]}
  ]
}
