[resource]
script = ExtResource("1")
id = "mara"
display_name = "Mara Vale"
position = Vector2(300, 250)
morning_position = Vector2(300, 250)
day_position = Vector2(360, 220)
evening_position = Vector2(330, 270)
routine_speed = 20.0
default_dialogue = "The river remembers every footstep. Most people just don't listen anymore."
relationship_dialogue = "You are getting better at listening, Wayfarer. The valley changes around people who pay attention."
evening_dialogue = "The market is closed now. Come back with the morning bell."
post_echo_dialogue = "You heard it. I can tell. The valley has been waiting for someone willing to listen."
evening_hour = 18
morning_dialogue = "Morning's best. The river catches the first light before the market wakes."
day_dialogue = "Bring me what the valley gave you. I like seeing people turn a walk into a reason to stay."
weather_dialogue = "Rain makes old paths honest. You can see which ones still matter."
favourite_activity = "fishing"
favourite_location = "market"
goal_flag = "market_trade"
goal_dialogue = "The market feels different now. You keep bringing pieces of the valley home, and somehow the whole village benefits."
relationship_id = "mara"
