morning_dialogue = "The valley reads differently before noon. Fewer footsteps. More old things willing to be noticed."
day_dialogue = "Map what you find. A place remembered by one person is fragile; a route walked by many becomes part of the valley again."
weather_dialogue = "Weather changes the evidence. Mud, water, broken branches — all of it says where people have been."
favourite_activity = "wayfinding"
