[resource]
script = ExtResource("1")
id = "bellroot_ledger"
title = "The Miner's Ledger"
discovery_text = "The old ledger remembers names, shifts and meals owed. Bellroot was not simply a mine. It was a place full of ordinary lives."
repeat_text = "Dust gathers over the names. The ledger remembers anyway."
prerequisite_flags = ["bellroot_memory_echo"]
prerequisite_activities = {"mining": 3, "archaeology": 1}
completion_flag = "bellroot_ledger_echo"
quest_stage = 6
memory_xp = 30
xp_reward = 60
item_id = "antique"
item_amount = 1
position = Vector2(155, 395)
memory_kind = "event"
knowledge_tag = "bellroot_history"
world_memory_id = "bellroot_ledger"
consequence_text = "Recovered names deepen Rowan's knowledge and make future Bellroot discoveries more valuable."
unlock_flags = ["bellroot_history_known"]
