; Everdune — Godot 4.x vertical slice
; Engine decision: Godot 4.x / GDScript / 2D pixel-first / Steam target.

config_version=5

[application]
config/name="Everdune"
config/description="Everdune — The World Remembers."
run/main_scene="res://scenes/main.tscn"

[display]
window/size/viewport_width=960
window/size/viewport_height=540
window/size/window_width_override=1440
window/size/window_height_override=810
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0

[input]
move_up={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":87), Object(InputEventKey,"physical_keycode":4194320)]
}
move_down={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":83), Object(InputEventKey,"physical_keycode":4194322)]
}
move_left={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":65), Object(InputEventKey,"physical_keycode":4194319)]
}
move_right={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":68), Object(InputEventKey,"physical_keycode":4194321)]
}
interact={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":69)]
}
attack={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":32)]
}
inventory={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":73)]
}
save={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":75)]
}
load={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":76)]
}
